# Production Environment Configuration

# MongoDB
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority&maxPoolSize=100
MONGODB_DB=docbook
MONGODB_COLLECTION=app_state

# Security - MUST be at least 32 characters, mixed case + numbers
JWT_SECRET=GENERATE_STRONG_SECRET_32_CHARS_MIN

# Admin (only used on first startup)
ADMIN_NAME=Platform Admin
ADMIN_PHONE=+94XXXXXXXXX
ADMIN_EMAIL=admin@docbook.app
ADMIN_PASSWORD=STRONG_INITIAL_PASSWORD

# Rate limiting is enabled by default
# Defaults: Login/Register 10 req/min, General 30 req/min

# Deployment
NODE_ENV=production
